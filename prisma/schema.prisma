generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  FASTING
  FASTING_LITE
  CASTING
  FASTING_BOT
  CASTING_BOT
  FROOKIES
  ROOKIES
  FROOKIES_BOT
  ROOKIES_BOT
  SURVIVOR
  SURVIVOR_BOT
}

enum GameState {
  ENROLLING
  ROUND_NOMINATE
  ROUND_VOTE
  FINAL3
  JURY_VOTE
  COMPLETED
}

enum PlayerStatus {
  ACTIVE
  ELIMINATED
}

enum ChatChannel {
  PUBLIC
  PRIVATE
}

enum ReactionType {
  PLUS
  MINUS
}

enum CastingDropKind {
  APPLE
  KEY
}

enum CastingDropType {
  NORMAL
  CARE_PACKAGE
}

enum CastingDropOptionKind {
  APPLE
  KEY
  POISON
}

model CastingDropEvent {
  id        String          @id @default(cuid())
  gameId    String
  dayNumber Int
  kind      CastingDropKind
  createdAt DateTime        @default(now())

  dropType         CastingDropType @default(NORMAL)
  recipientUserId  String?         // CARE_PACKAGE: only this user can see/claim
  messageId        String?         @unique // NORMAL: chat message; CARE_PACKAGE: null

  claimedByUserId String?
  claimedAt       DateTime?

  game    Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  options CastingDropOption[]

  @@index([gameId, dayNumber, createdAt])
  @@index([gameId, claimedAt])
  @@index([gameId, recipientUserId, claimedAt])
}

model CastingDropOption {
  id        String                @id @default(cuid())
  eventId   String
  slotIndex Int
  kind      CastingDropOptionKind

  event CastingDropEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotIndex])
  @@index([eventId])
}

model User {
  id String @id @default(cuid())

  equippedColorId Int?
  equippedColor   ColorLevel? @relation("EquippedColor", fields: [equippedColorId], references: [id], onDelete: SetNull)

  // display username (caps preserved)
  username String

  // unique normalized username for lookups
  usernameLower String @unique

  passwordHash String
  // Steam: when set, user logs in via Steam only
  steamId      String?  @unique
  createdAt    DateTime @default(now())

  karma      Int      @default(0)
  tMoney     Int      @default(0)
  pMoney     Int      @default(0)
  blogREarnedToday  Int      @default(0)
  blogRResetDate    String?  // YYYY-MM-DD
  lastSeenAt DateTime @default(now())

  // ✅ Email verification (beta)
  email                String?   @unique
  emailVerifiedAt      DateTime?
  emailVerifyCodeHash  String?
  emailVerifyExpiresAt DateTime?
  emailVerifySentAt    DateTime?
  emailVerifyAttempts  Int       @default(0)

  // (Optional) phone fields can stay if you want, but not required
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?

  bio String @default("")

  // Owner / moderation
  isOwner       Boolean   @default(false)
  lockedLoginIp String?
  bannedAt      DateTime?
  banReason     String?
  warnedAt      DateTime?
  usernameChangedAt DateTime?

  // AVATAR
  bodyStyle      String @default("body_m")
  hairStyle      String @default("hair_m_01")
  eyesStyle      String @default("eyes_01")
  mouthStyle     String @default("mouth_01")
  shirtStyle     String @default("shirt_01")
  accessoryStyle     String @default("none")
  glassesStyle       String @default("none")
  scarStyle          String @default("none")
  hairOrnamentStyle  String @default("none")

  bodyColor          String @default("#F1C27D")
  hairColor          String @default("#2B1B0E")
  eyeColor           String @default("#2E7DFF")
  mouthColor         String @default("#E0AC69")
  shirtColor         String @default("#E53935")
  accessoryColor     String @default("#111111")
  backgroundColor    String @default("#E8E8E8")
  glassesColor       String @default("#111111")
  scarColor          String @default("#8B4513")
  hairOrnamentColor  String @default("#C0C0C0")

  enrollments Enrollment[]
  gamePlayers GamePlayer[]
  messages    GameMessage[]
  reactions   MessageReaction[]
  colorBuys   UserColor[]

  pmSent     GamePmMessage[] @relation("PmSender")
  pmReceived GamePmMessage[] @relation("PmRecipient")

  directMessagesSent    DirectMessage[] @relation("DMSender")
  directMessagesReceived DirectMessage[] @relation("DMRecipient")

  blogPosts      BlogPost[]
  postVotes      PostVote[]
  blogComments   BlogComment[]
  commentVotes   CommentVote[]

  designs           Design[]
  designVotes       DesignVote[]
  designComments    DesignComment[]
  designCommentVotes DesignCommentVote[]
  auctionBids       AuctionBid[]
  auctionsLeading   Auction[]    @relation("AuctionHighBidder")

  designOwnerships DesignOwner[]

  equippedShirtDesignId     String?
  equippedHairDesignId      String?
  equippedBodyDesignId      String?
  equippedEyesDesignId      String?
  equippedMouthDesignId     String?
  equippedAccessoryDesignId     String?
  equippedBackgroundDesignId   String?
  equippedScarDesignId         String?
  equippedHairOrnamentDesignId String?
  equippedGlassesDesignId      String?

  equippedShirtDesign       Design? @relation("EquippedShirt", fields: [equippedShirtDesignId], references: [id], onDelete: SetNull)
  equippedHairDesign        Design? @relation("EquippedHair", fields: [equippedHairDesignId], references: [id], onDelete: SetNull)
  equippedBodyDesign        Design? @relation("EquippedBody", fields: [equippedBodyDesignId], references: [id], onDelete: SetNull)
  equippedEyesDesign        Design? @relation("EquippedEyes", fields: [equippedEyesDesignId], references: [id], onDelete: SetNull)
  equippedMouthDesign       Design? @relation("EquippedMouth", fields: [equippedMouthDesignId], references: [id], onDelete: SetNull)
  equippedAccessoryDesign   Design? @relation("EquippedAccessory", fields: [equippedAccessoryDesignId], references: [id], onDelete: SetNull)
  equippedBackgroundDesign   Design? @relation("EquippedBackground", fields: [equippedBackgroundDesignId], references: [id], onDelete: SetNull)
  equippedScarDesign         Design? @relation("EquippedScar", fields: [equippedScarDesignId], references: [id], onDelete: SetNull)
  equippedHairOrnamentDesign Design? @relation("EquippedHairOrnament", fields: [equippedHairOrnamentDesignId], references: [id], onDelete: SetNull)
  equippedGlassesDesign     Design? @relation("EquippedGlasses", fields: [equippedGlassesDesignId], references: [id], onDelete: SetNull)

  friendsAsUser   Friendship[] @relation("UserFriends")
  friendsAsFriend Friendship[] @relation("FriendOf")

  @@index([usernameLower])
}

model Friendship {
  id       String   @id @default(cuid())
  userId   String
  friendId String
  position Int      @default(0)
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model BlogPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    PostVote[]
  comments BlogComment[]

  @@index([authorId])
  @@index([createdAt])
}

model PostVote {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommentVote[]

  @@index([postId])
}

model CommentVote {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

enum DesignType {
  BODY
  HAIR
  EYES
  MOUTH
  SHIRT
  ACCESSORY
  BACKGROUND
  SCAR
  HAIR_ORNAMENT
  GLASSES
}

model Design {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String
  designType  DesignType @default(HAIR)
  image       Bytes
  contentType String     @default("image/png")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    DesignVote[]
  comments DesignComment[]
  auctions Auction[]
  owners   DesignOwner[]

  equippedByShirt         User[] @relation("EquippedShirt")
  equippedByHair          User[] @relation("EquippedHair")
  equippedByBody          User[] @relation("EquippedBody")
  equippedByEyes          User[] @relation("EquippedEyes")
  equippedByMouth         User[] @relation("EquippedMouth")
  equippedByAccessory     User[] @relation("EquippedAccessory")
  equippedByBackground     User[] @relation("EquippedBackground")
  equippedByScar           User[] @relation("EquippedScar")
  equippedByHairOrnament   User[] @relation("EquippedHairOrnament")
  equippedByGlasses        User[] @relation("EquippedGlasses")

  @@index([createdAt])
  @@index([designType])
}

model DesignOwner {
  id        String   @id @default(cuid())
  userId    String
  designId  String
  acquiredAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
  @@index([userId])
  @@index([designId])
}

model DesignVote {
  id        String       @id @default(cuid())
  designId  String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([designId, userId])
  @@index([designId])
}

model DesignComment {
  id        String   @id @default(cuid())
  designId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  design Design            @relation(fields: [designId], references: [id], onDelete: Cascade)
  author User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  DesignCommentVote[]

  @@index([designId])
}

model DesignCommentVote {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  comment DesignComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Auction {
  id               String    @id @default(cuid())
  designId         String
  startsAt         DateTime
  endsAt           DateTime
  currentBid       Int       @default(5)
  currentBidUserId String?
  soldAt           DateTime? // when resolved; winner paid, seller got 50%
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  design         Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  currentBidUser User?  @relation("AuctionHighBidder", fields: [currentBidUserId], references: [id], onDelete: SetNull)
  bids           AuctionBid[]

  @@index([endsAt])
  @@index([soldAt])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model ColorLevel {
  id          Int     @id
  name        String  @unique
  karmaNeeded Int
  priceT      Int
  strength    Int
  isAnimated  Boolean @default(false)

  purchases UserColor[]

  equippedBy User[] @relation("EquippedColor")
}

model UserColor {
  id          String   @id @default(cuid())
  userId      String
  colorId     Int
  purchasedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  color ColorLevel @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([userId, colorId])
  @@index([userId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  gameType  GameType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
  @@index([gameType, createdAt])
}

model Game {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  gameType    GameType
  state       GameState @default(ENROLLING)
  roundNumber Int       @default(0)

  startsAt       DateTime?
  stateEndsAt    DateTime?
  roundStartedAt DateTime?

  povUserId       String?  // POV holder (veto); in FASTING = nominator
  hohUserId       String?  // HOH (nominates 2) for FROOKIES / ROOKIES
  povSavedUserId  String?  // FROOKIES: who POV saved this round (immune from noms); cleared when round result is written
  frookiesPhase   String?  // FROOKIES: 'POV_SAVE' = waiting for POV after HOH noms; 'HOH_RENOM' = need 1 replacement after POV saved a nominee
  createdAt       DateTime  @default(now())
  completedAt DateTime?

  players       GamePlayer[]
  nominations   Nomination[]
  evictionVotes EvictionVote[]
  rankingVotes  RankingVote[]
  messages      GameMessage[]
  roundResults  RoundResult[]
  pmMessages    GamePmMessage[]
  juryVotes     JuryVote[]

  // CASTINGS day system (dayEndsAt = stateEndsAt during ROUND_VOTE)
  castingDayStartedAt     DateTime?
  castingDayProcessedAt   DateTime? // prevent double day change
  castingLastAppleHourKey String?
  castingLastKeyHourKey   String?
  castingLastDecayHourKey String? // CASTING: decay runs every hour
  castingDropEvents       CastingDropEvent[]
  castingDays             CastingDayResult[]
  castingVotes            CastingVote[]

  // Survivor
  survivorPhase           String? // TRIBE_CHALLENGE | IMMUNITY | TRIBAL_COUNCIL | MERGE | INDIVIDUAL_CHALLENGE | INDIVIDUAL_IMMUNITY | VOTE
  tribeAFood              Int     @default(40)
  tribeAWater             Int     @default(40)
  tribeAFire              Boolean @default(true)
  tribeBFood              Int     @default(40)
  tribeBWater             Int     @default(40)
  tribeBFire              Boolean @default(true)
  /** SUN | RAIN | CLOUDY — weather for gathering */
  tribeAWeather           String  @default("SUN")
  tribeBWeather           String  @default("SUN")
  tribeAGatherReadyAt     DateTime?
  tribeBGatherReadyAt     DateTime?
  /** While set and in the future, tribe is collecting rain (no drinking from stock). */
  tribeARainUntil         DateTime?
  tribeBRainUntil         DateTime?
  /** When fire is out, relights at this time. */
  tribeAFireUntil         DateTime?
  tribeBFireUntil         DateTime?
  survivorMerged          Boolean @default(false)
  /** True when this lobby is the post-tribe merge game (10 seats, starts individual). */
  survivorIsMerge         Boolean @default(false)
  losingTribe             String? // A | B during tribal

  rookiesBets             RookiesBet[]

  @@index([state, stateEndsAt])
}

model RookiesBet {
  id           String    @id @default(cuid())
  gameId       String
  betterUserId String
  targetUserId String
  amount       Int
  paidOutAt    DateTime?
  payoutAmount Int?

  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, betterUserId])
  @@index([gameId])
  @@index([betterUserId])
}

model GamePlayer {
  id     String       @id @default(cuid())
  gameId String
  userId String
  status PlayerStatus @default(ACTIVE)

  joinedAt     DateTime  @default(now())
  eliminatedAt DateTime?

  lastActiveAt    DateTime @default(now())
  eliminatedPlace Int?

  povWins    Int @default(0)
  chatCount  Int @default(0)
  plusCount  Int @default(0)
  minusCount Int @default(0)

  lastHadPovRound Int?

  seatIndex Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CASTINGS
  health Int @default(70)
  keys   Int @default(0)

  castingDayMiniGameScore Int @default(0)

  lastCarePackageAtChecks Int @default(0)

  castingLastDecayAt       DateTime?
  castingHealthGainedToday Int       @default(0)
  castingHealthTickedAt    DateTime?

  // Survivor (food/water are personal % 0–100)
  tribe                String? // A | B | MERGED
  food                 Int     @default(70)
  water                Int     @default(70)
  hasImmunity          Boolean @default(false)
  sittingOut           Boolean @default(false)
  challengeScore       Int     @default(0)
  lastGatherAt         DateTime?

  @@unique([gameId, userId])
  @@unique([gameId, seatIndex])
  @@index([gameId, status])
  @@index([gameId, seatIndex])
}

model Nomination {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, roundNumber])
  @@index([gameId, roundNumber, targetUserId])
}

model EvictionVote {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber, voterUserId])
  @@index([gameId, roundNumber, targetUserId])
}

model RankingVote {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  points       Int      // 1=save, 2=evict if #1 saved, 3=evict
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber, voterUserId, targetUserId])
  @@index([gameId, roundNumber])
}

model RoundResult {
  id              String   @id @default(cuid())
  gameId          String
  roundNumber     Int
  nomineeAUserId  String
  nomineeBUserId  String
  nomineeCUserId  String?  // ROOKIES: 3rd nominee (algorithm / HOH)
  nomineeDUserId  String?  // ROOKIES: 4th nominee (algorithm; null at final 5)
  evictedUserId   String?
  povSavedUserId  String?  // FROOKIES: who POV saved (replacement then chosen by HOH)
  createdAt       DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
}

model GameMessage {
  id        String      @id @default(cuid())
  gameId    String
  userId    String
  channel   ChatChannel
  body      String
  createdAt DateTime    @default(now())
  /// Survivor pre-merge: "A" | "B". Null = all / merged / non-Survivor.
  tribe     String?

  game      Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([gameId, channel, createdAt])
  @@index([gameId, tribe, createdAt])
}

model MessageReaction {
  id            String       @id @default(cuid())
  messageId     String
  reactorUserId String
  type          ReactionType
  createdAt     DateTime     @default(now())

  message GameMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactor User        @relation(fields: [reactorUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorUserId])
  @@index([messageId, type])
}

model GamePmMessage {
  id              String   @id @default(cuid())
  gameId          String
  senderUserId    String
  recipientUserId String
  body            String
  createdAt       DateTime @default(now())

  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sender    User @relation("PmSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("PmRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([gameId, senderUserId, recipientUserId, createdAt])
}

model DirectMessage {
  id              String    @id @default(cuid())
  senderUserId    String
  recipientUserId String
  body            String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  sender    User @relation("DMSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("DMRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([senderUserId, recipientUserId, createdAt])
}

model CastingDayResult {
  id            String   @id @default(cuid())
  gameId         String
  dayNumber      Int
  nomineeUserIds String[]
  evictedUserIds String[]
  createdAt      DateTime @default(now())

  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, dayNumber])
  @@index([gameId, dayNumber])
}

model JuryVote {
  id           String   @id @default(cuid())
  gameId       String
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, voterUserId])
  @@index([gameId])
  @@index([gameId, targetUserId])
}

model CastingVote {
  id          String   @id @default(cuid())
  gameId       String
  dayNumber    Int
  voterUserId  String
  targetUserId String
  points       Int
  createdAt    DateTime @default(now())

  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, dayNumber, voterUserId, targetUserId])
  @@index([gameId, dayNumber])
  @@index([gameId, dayNumber, targetUserId])
}
