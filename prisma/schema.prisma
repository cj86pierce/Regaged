generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  FASTING
  FASTING_LITE
}

enum GameState {
  ENROLLING
  ROUND_NOMINATE
  ROUND_VOTE
  FINAL3
  COMPLETED
}

enum PlayerStatus {
  ACTIVE
  ELIMINATED
}

enum ChatChannel {
  PUBLIC
  PRIVATE
}

enum ReactionType {
  PLUS
  MINUS
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  karma  Int @default(0)
  tMoney Int @default(0)

  // site-wide activity
  lastSeenAt DateTime @default(now())

  // =========================
  // AVATAR (PNG PARTS + COLORS)
  // =========================
  bodyStyle      String @default("body_m") // body_m | body_f
  hairStyle      String @default("hair_m_01") // hair_m_01... hair_f_03...
  eyesStyle      String @default("eyes_01") // eyes_01..eyes_06
  mouthStyle     String @default("mouth_01") // mouth_01..mouth_06
  shirtStyle     String @default("shirt_01") // shirt_01..shirt_06
  accessoryStyle String @default("none") // none | accessory_01

  bodyColor      String @default("#F1C27D")
  hairColor      String @default("#2B1B0E")
  eyeColor       String @default("#2E7DFF")
  mouthColor     String @default("#E0AC69")
  shirtColor     String @default("#E53935")
  accessoryColor String @default("#111111")
  // =========================

  enrollments Enrollment[]
  gamePlayers GamePlayer[]
  messages    GameMessage[]
  reactions   MessageReaction[]
  colorBuys   UserColor[]
}

model ColorLevel {
  id          Int     @id
  name        String  @unique
  karmaNeeded Int
  priceT      Int
  strength    Int
  isAnimated  Boolean @default(false)

  purchases UserColor[]
}

model UserColor {
  id          String   @id @default(cuid())
  userId      String
  colorId     Int
  purchasedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  color ColorLevel @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([userId, colorId])
  @@index([userId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  gameType  GameType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
  @@index([gameType, createdAt])
}

model Game {
  id String @id @default(cuid())

  // nice human-readable counter for display (keeps increasing even if you delete games)
  number Int @unique @default(autoincrement())

  gameType    GameType
  state       GameState @default(ENROLLING)
  roundNumber Int       @default(0)

  startsAt    DateTime?
  stateEndsAt DateTime?

  povUserId   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  players       GamePlayer[]
  nominations   Nomination[]
  evictionVotes EvictionVote[]
  messages      GameMessage[]
  roundResults  RoundResult[]

  @@index([state, stateEndsAt])
}

model GamePlayer {
  id     String       @id @default(cuid())
  gameId String
  userId String
  status PlayerStatus @default(ACTIVE)

  joinedAt     DateTime  @default(now())
  eliminatedAt DateTime?

  lastActiveAt    DateTime @default(now())
  eliminatedPlace Int?

  povWins    Int @default(0)
  chatCount  Int @default(0)
  plusCount  Int @default(0)
  minusCount Int @default(0)

  lastHadPovRound Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId, status])
}

model Nomination {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, roundNumber])
  @@index([gameId, roundNumber, targetUserId])
}

model EvictionVote {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber, voterUserId])
  @@index([gameId, roundNumber, targetUserId])
}

model RoundResult {
  id             String   @id @default(cuid())
  gameId         String
  roundNumber    Int
  nomineeAUserId String
  nomineeBUserId String
  evictedUserId  String?
  createdAt      DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
}

model GameMessage {
  id        String      @id @default(cuid())
  gameId    String
  userId    String
  channel   ChatChannel
  body      String
  createdAt DateTime    @default(now())

  game      Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([gameId, channel, createdAt])
}

model MessageReaction {
  id            String       @id @default(cuid())
  messageId     String
  reactorUserId String
  type          ReactionType
  createdAt     DateTime     @default(now())

  message GameMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactor User        @relation(fields: [reactorUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorUserId])
  @@index([messageId, type])
}
