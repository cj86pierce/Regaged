generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  FASTING
  FASTING_LITE
  CASTING
  FASTING_BOT
  CASTING_BOT
}

enum GameState {
  ENROLLING
  ROUND_NOMINATE
  ROUND_VOTE
  FINAL3
  COMPLETED
}

enum PlayerStatus {
  ACTIVE
  ELIMINATED
}

enum ChatChannel {
  PUBLIC
  PRIVATE
}

enum ReactionType {
  PLUS
  MINUS
}

enum CastingDropKind {
  APPLE
  KEY
}

enum CastingDropOptionKind {
  APPLE
  KEY
  POISON
}

model CastingDropEvent {
  id        String          @id @default(cuid())
  gameId    String
  dayNumber Int
  kind      CastingDropKind
  createdAt DateTime        @default(now())

  messageId String @unique

  claimedByUserId String?
  claimedAt       DateTime?

  game    Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  options CastingDropOption[]

  @@index([gameId, dayNumber, createdAt])
  @@index([gameId, claimedAt])
}

model CastingDropOption {
  id        String                @id @default(cuid())
  eventId   String
  slotIndex Int
  kind      CastingDropOptionKind

  event CastingDropEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotIndex])
  @@index([eventId])
}

model User {
  id String @id @default(cuid())

  equippedColorId Int?
  equippedColor   ColorLevel? @relation("EquippedColor", fields: [equippedColorId], references: [id], onDelete: SetNull)

  // display username (caps preserved)
  username String

  // unique normalized username for lookups
  usernameLower String @unique

  passwordHash String
  // Steam: when set, user logs in via Steam only
  steamId      String?  @unique
  createdAt    DateTime @default(now())

  karma      Int      @default(0)
  tMoney     Int      @default(0)
  pMoney     Int      @default(0)
  blogREarnedToday  Int      @default(0)
  blogRResetDate    String?  // YYYY-MM-DD
  lastSeenAt DateTime @default(now())

  // ✅ Email verification (beta)
  email                String?   @unique
  emailVerifiedAt      DateTime?
  emailVerifyCodeHash  String?
  emailVerifyExpiresAt DateTime?
  emailVerifySentAt    DateTime?
  emailVerifyAttempts  Int       @default(0)

  // (Optional) phone fields can stay if you want, but not required
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?

  bio String @default("")

  // AVATAR
  bodyStyle      String @default("body_m")
  hairStyle      String @default("hair_m_01")
  eyesStyle      String @default("eyes_01")
  mouthStyle     String @default("mouth_01")
  shirtStyle     String @default("shirt_01")
  accessoryStyle String @default("none")

  bodyColor      String @default("#F1C27D")
  hairColor      String @default("#2B1B0E")
  eyeColor       String @default("#2E7DFF")
  mouthColor     String @default("#E0AC69")
  shirtColor     String @default("#E53935")
  accessoryColor String @default("#111111")

  enrollments Enrollment[]
  gamePlayers GamePlayer[]
  messages    GameMessage[]
  reactions   MessageReaction[]
  colorBuys   UserColor[]

  pmSent     GamePmMessage[] @relation("PmSender")
  pmReceived GamePmMessage[] @relation("PmRecipient")

  blogPosts      BlogPost[]
  postVotes      PostVote[]
  blogComments   BlogComment[]
  commentVotes   CommentVote[]

  friendsAsUser   Friendship[] @relation("UserFriends")
  friendsAsFriend Friendship[] @relation("FriendOf")

  @@index([usernameLower])
}

model Friendship {
  id       String   @id @default(cuid())
  userId   String
  friendId String
  position Int      @default(0)
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model BlogPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    PostVote[]
  comments BlogComment[]

  @@index([authorId])
  @@index([createdAt])
}

model PostVote {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommentVote[]

  @@index([postId])
}

model CommentVote {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType
  points    Int
  createdAt DateTime     @default(now())

  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model ColorLevel {
  id          Int     @id
  name        String  @unique
  karmaNeeded Int
  priceT      Int
  strength    Int
  isAnimated  Boolean @default(false)

  purchases UserColor[]

  equippedBy User[] @relation("EquippedColor")
}

model UserColor {
  id          String   @id @default(cuid())
  userId      String
  colorId     Int
  purchasedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  color ColorLevel @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([userId, colorId])
  @@index([userId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  gameType  GameType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
  @@index([gameType, createdAt])
}

model Game {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  gameType    GameType
  state       GameState @default(ENROLLING)
  roundNumber Int       @default(0)

  startsAt       DateTime?
  stateEndsAt    DateTime?
  roundStartedAt DateTime?

  povUserId   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  players       GamePlayer[]
  nominations   Nomination[]
  evictionVotes EvictionVote[]
  messages      GameMessage[]
  roundResults  RoundResult[]
  pmMessages    GamePmMessage[]

  // CASTINGS drop scheduling
  castingDayStartedAt     DateTime?
  castingLastAppleHourKey String?
  castingLastKeyHourKey   String?
  castingDropEvents       CastingDropEvent[]
  castingDays             CastingDayResult[]
  castingVotes            CastingVote[]

  @@index([state, stateEndsAt])
}

model GamePlayer {
  id     String       @id @default(cuid())
  gameId String
  userId String
  status PlayerStatus @default(ACTIVE)

  joinedAt     DateTime  @default(now())
  eliminatedAt DateTime?

  lastActiveAt    DateTime @default(now())
  eliminatedPlace Int?

  povWins    Int @default(0)
  chatCount  Int @default(0)
  plusCount  Int @default(0)
  minusCount Int @default(0)

  lastHadPovRound Int?

  seatIndex Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CASTINGS
  health Int @default(70)
  keys   Int @default(0)

  castingLastDecayAt       DateTime?
  castingHealthGainedToday Int       @default(0)
  castingHealthTickedAt    DateTime?

  @@unique([gameId, userId])
  @@unique([gameId, seatIndex])
  @@index([gameId, status])
  @@index([gameId, seatIndex])
}

model Nomination {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, roundNumber])
  @@index([gameId, roundNumber, targetUserId])
}

model EvictionVote {
  id           String   @id @default(cuid())
  gameId       String
  roundNumber  Int
  voterUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber, voterUserId])
  @@index([gameId, roundNumber, targetUserId])
}

model RoundResult {
  id             String   @id @default(cuid())
  gameId         String
  roundNumber    Int
  nomineeAUserId String
  nomineeBUserId String
  evictedUserId  String?
  createdAt      DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
}

model GameMessage {
  id        String      @id @default(cuid())
  gameId    String
  userId    String
  channel   ChatChannel
  body      String
  createdAt DateTime    @default(now())

  game      Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([gameId, channel, createdAt])
}

model MessageReaction {
  id            String       @id @default(cuid())
  messageId     String
  reactorUserId String
  type          ReactionType
  createdAt     DateTime     @default(now())

  message GameMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactor User        @relation(fields: [reactorUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorUserId])
  @@index([messageId, type])
}

model GamePmMessage {
  id              String   @id @default(cuid())
  gameId          String
  senderUserId    String
  recipientUserId String
  body            String
  createdAt       DateTime @default(now())

  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sender    User @relation("PmSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("PmRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([gameId, senderUserId, recipientUserId, createdAt])
}

model CastingDayResult {
  id            String   @id @default(cuid())
  gameId         String
  dayNumber      Int
  nomineeUserIds String[]
  evictedUserIds String[]
  createdAt      DateTime @default(now())

  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, dayNumber])
  @@index([gameId, dayNumber])
}

model CastingVote {
  id          String   @id @default(cuid())
  gameId       String
  dayNumber    Int
  voterUserId  String
  targetUserId String
  points       Int
  createdAt    DateTime @default(now())

  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, dayNumber, voterUserId, targetUserId])
  @@index([gameId, dayNumber])
  @@index([gameId, dayNumber, targetUserId])
}
